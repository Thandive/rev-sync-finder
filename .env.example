# Server-side only. Set these in Vercel → Project → Settings → Environment Variables.
# Never prefix with VITE_ (that would bundle the value into the browser code).

# Anthropic API key for the Pipeline Storyteller narrative (POST /api/narrative).
# Without it the page falls back to the rule-based narrative.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=

# Optional. Comma-separated origins allowed to call /api/narrative.
# Defaults to https://rev-sync.app,https://www.rev-sync.app
ALLOWED_ORIGINS=
